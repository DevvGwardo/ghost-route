# Port the Express server listens on.
PORT=8801
# Server-wide default TypeSafe key (optional since BYOK; leave blank for deterministic fallback scorer).
TYPESAFE_API_KEY=
# TypeSafe System One model name for live ranking.
JEV_MODEL=system_one
# Minimum JEV confidence before falling back to the geometric scorer.
CONFIDENCE_THRESHOLD=0.40
# Allowlisted OSRM routing backend (only this host is permitted by ssrfSafeUrl).
OSRM_BASE=https://router.project-osrm.org
