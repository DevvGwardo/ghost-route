# Port the Express server listens on.
PORT=8801
# Server-wide default TypeSafe key (optional since BYOK; leave blank for deterministic fallback scorer).
TYPESAFE_API_KEY=
# TypeSafe System One model name for live ranking.
JEV_MODEL=system_one
# Minimum JEV confidence before falling back to the geometric scorer.
CONFIDENCE_THRESHOLD=0.40
# Drop OSRM routes over this multiple of straight-line distance (when set;
# otherwise length-aware: 8x under 10km, 5x under 100km, 4x above).
ROUTE_MAX_FACTOR=
# Routing backend: demo (default, public OSRM) | fosssgis (higher-capacity
# public OSRM, one env var) | custom (self-hosted OSRM via OSRM_BASE below).
# Non-demo primaries fall back to demo once on hard failure; the active
# backend is reported on GET /api/system/status.
ROUTING_BACKEND=demo
# Custom backend origin (ROUTING_BACKEND=custom only). https required, no
# credentials; validated, fails safe to demo. Loopback needs ALLOW_LOCAL_ROUTING=1.
OSRM_BASE=
# Allow http(s) loopback custom backends (local OSRM docker). Default off.
ALLOW_LOCAL_ROUTING=
# Upstream routing timeout ms (default 8000, clamp 1000..30000).
ROUTING_TIMEOUT_MS=
# Routing response cache TTL ms (default 60000, clamp 10000..600000).
ROUTING_CACHE_TTL_MS=
